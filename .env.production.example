# ─── Copy this file to .env.production on your Hetzner server ───────────────
# NEVER commit this file to git — it contains secrets

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# Resend Email
RESEND_API_KEY=re_your-resend-key

# App
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_APP_NAME=AG Development
ADMIN_EMAIL=support@ag-development.dev

# Node
NODE_ENV=production

# Admin → Demo Offers: deleting a demo commits its removal to GitHub so the next
# deploy can't bring it back. Fine-grained token with "Contents: Read and write"
# on this repository only.
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=trajcheangjelovski-blip/ag-development-
GITHUB_BRANCH=main

# Optional: purge Cloudflare's edge cache for a deleted demo.
# API token with "Zone → Cache Purge" on ag-development.dev + that zone's ID.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
