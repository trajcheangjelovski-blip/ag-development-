# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Resend (Email) ───────────────────────────────────────────────────────────
# Get from: https://resend.com → API Keys
RESEND_API_KEY=re_your_api_key_here

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AG Development
ADMIN_EMAIL=support@ag-development.dev

# ─── Cron ────────────────────────────────────────────────────────────────────
# Secret that guards /api/cron/* endpoints (e.g. auto-waiting-client).
# Set any long random string, then have your scheduler send it as a Bearer token.
CRON_SECRET=change-me-to-a-long-random-string
