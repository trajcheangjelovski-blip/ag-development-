# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Resend (Email) ───────────────────────────────────────────────────────────
# Get from: https://resend.com → API Keys
RESEND_API_KEY=re_your_api_key_here

# ─── Infobip (Viber Business Messages) ────────────────────────────────────────
# From the Infobip portal → your account. Each account has its own base URL.
INFOBIP_BASE_URL=https://xxxxx.api.infobip.com
INFOBIP_API_KEY=your-infobip-api-key
INFOBIP_VIBER_SENDER=YourApprovedSender
# Optional: override the send endpoint path if your account uses the older
# channel-specific API (default: /messages-api/1/messages).
# INFOBIP_MESSAGES_PATH=/messages-api/1/messages
# Shared secret that guards the delivery/inbound webhook (?token=...).
INFOBIP_WEBHOOK_TOKEN=change-me-to-a-long-random-string

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AG Development
ADMIN_EMAIL=support@ag-development.dev

# ─── Cron ────────────────────────────────────────────────────────────────────
# Secret that guards /api/cron/* endpoints (e.g. auto-waiting-client).
# Set any long random string, then have your scheduler send it as a Bearer token.
CRON_SECRET=change-me-to-a-long-random-string
